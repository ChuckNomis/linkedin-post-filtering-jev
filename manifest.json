{
  "manifest_version": 3,
  "name": "LinkedIn Post Filter (Jev-Powered)",
  "version": "1.1.0",
  "description": "Highlights job posts on LinkedIn that match your search criteria and dims non-job content, using Jev AI classification.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/feed/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "LinkedIn Post Filter Settings",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
